PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=monity
DB_USER=postgres
DB_PASSWORD=postgres
JWT_SECRET=your-secret-key-change-in-production
EXCHANGE_RATE_API_KEY=your-api-key

# Email (SMTP) - for OTP password reset.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, use an App Password.
# When unset, OTPs are logged to the server console (development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Monity <no-reply@yourdomain.com>
