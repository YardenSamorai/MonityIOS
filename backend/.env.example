PORT=3000
NODE_ENV=development

# SQLite storage path (default: backend/monity.sqlite if unset)
DATABASE_PATH=

# Set to 'true' in production if you manage schema with migrations only (skips sequelize sync alter)
DB_NO_ALTER=false

JWT_SECRET=your-secret-key-change-in-production

# Comma-separated origins for CORS (empty = permissive dev defaults)
CORS_ORIGINS=

EXCHANGE_RATE_API_KEY=your-api-key

# Optional error monitoring (leave empty to disable)
SENTRY_DSN=

# Email (SMTP) - for OTP password reset.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, use an App Password.
# When unset, OTPs are logged to the server console (development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Monity <no-reply@yourdomain.com>

# Local DB backup: from backend/, run scripts/backup-sqlite.sh
# Respects DATABASE_PATH; writes to <db-dir>/backups/monity-YYYYMMDD-HHMMSS.sqlite
